{
  "openapi": "3.0.0",
  "info": {
    "title": "Vulnerable API for BOLA Testing",
    "version": "1.0.0",
    "description": "Intentionally vulnerable API with BOLA/IDOR issues for security testing. DO NOT USE IN PRODUCTION!"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "example": "alice"
          },
          "email": {
            "type": "string",
            "example": "alice@test.com"
          },
          "role": {
            "type": "string",
            "example": "user"
          },
          "balance": {
            "type": "number",
            "example": 1000
          },
          "is_admin": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 100
          },
          "userId": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "My First Post"
          },
          "content": {
            "type": "string",
            "example": "This is the post content"
          },
          "author": {
            "type": "string",
            "example": "alice"
          },
          "is_featured": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 500
          },
          "userId": {
            "type": "integer",
            "example": 1
          },
          "product": {
            "type": "string",
            "example": "Laptop"
          },
          "amount": {
            "type": "number",
            "example": 1200
          },
          "status": {
            "type": "string",
            "example": "pending"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "newuser"
                  },
                  "email": {
                    "type": "string",
                    "example": "newuser@test.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "integer"
                    },
                    "username": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
